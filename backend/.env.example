# local uses SQLite, local files, and signed demo JWTs. Never use this mode for production.
APP_MODE=local
DATABASE_PATH=./data/diet_planner.db
LOCAL_STORAGE_PATH=./data/uploads
JWT_SECRET=replace-with-a-long-random-value
JWT_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:5173

# Supabase cloud mode: create a project, run cloud/schema.sql, then set these values.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional server-side AI API. If unset or unavailable, rule-based recommendations are used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional AI voice Q&A (Gemini API; keep this key server-side only).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Gnani Prisma speech-to-text key (create one in https://app.gnani.ai/)
GNANI_API_KEY=
GNANI_TTS_MODEL=timbre-v3.0
